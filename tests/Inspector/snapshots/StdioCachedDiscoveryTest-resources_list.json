      "uri": "app://version",
      "description": "The application version",
      "mimeType": "text/plain"
    },
    {
      "name": "weather-app",
      "uri": "ui://weather-app",
      "description": "Interactive weather dashboard",
      "mimeType": "text/html;profile=mcp-app",
      "_meta": {
        "ui": {}
      }
    }
  ]
}
