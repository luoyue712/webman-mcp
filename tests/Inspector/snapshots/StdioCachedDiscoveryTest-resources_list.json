{
  "resources": [
    {
      "name": "calculator_config",
      "uri": "config://calculator/settings",
      "description": "Current settings for the calculator tool (precision, allow_negative).",
      "mimeType": "application/json"
    },
    {
      "name": "system_stats",
      "uri": "stats://system/overview",
